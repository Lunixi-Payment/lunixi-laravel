{
    "name": "lunixi/laravel",
    "description": "Laravel integration for the Lunixi PHP SDK — configuration, container bindings, webhook route, checkout form component and payment reconciliation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "lunixi",
        "laravel",
        "payment",
        "gateway",
        "webhook"
    ],
    "homepage": "https://lunixi.com",
    "authors": [
        {
            "name": "Lunixi",
            "homepage": "https://lunixi.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "lunixi/php-sdk": "^0.28"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Lunixi\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lunixi\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lunixi\\Laravel\\LunixiServiceProvider"
            ],
            "aliases": {
                "Lunixi": "Lunixi\\Laravel\\Facades\\Lunixi"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
